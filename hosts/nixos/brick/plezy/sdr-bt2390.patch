@@ -194,2 +194,2 @@ void TestSdrRequestWithdrawsEveryHdrProperty() {
-// white, in the surface's real terms rather than assumed ones. mobius is the
-// operator that measurement selected, and it is applied here and nowhere else.
+// white, in the surface's real terms rather than assumed ones. BT.2390 is the
+// user-selected SDR operator, applied here and nowhere else.
@@ -204,2 +204,2 @@ void TestSdrRequestWithAReferenceWhiteNamesTheMeasuredTerms() {
-      core, {{"target-trc", "srgb"}, {"target-prim", "auto"}, {"tone-mapping", "mobius"}, {"target-peak", "203"}},
-      "an SDR request with a reference white must name sRGB, mobius and that white");
+      core, {{"target-trc", "srgb"}, {"target-prim", "auto"}, {"tone-mapping", "bt.2390"}, {"target-peak", "203"}},
+      "an SDR request with a reference white must name sRGB, BT.2390 and that white");
@@ -207 +207 @@ void TestSdrRequestWithAReferenceWhiteNamesTheMeasuredTerms() {
-  CheckApplied(player, "srgb", "auto", "mobius", "203", "the applied cache must hold exactly what was written");
+  CheckApplied(player, "srgb", "auto", "bt.2390", "203", "the applied cache must hold exactly what was written");
@@ -267 +267 @@ void TestRefusedStepUnwindsNewestFirstAndReportsRestored() {
-       {"tone-mapping", "mobius"},
+       {"tone-mapping", "bt.2390"},
@@ -295 +295 @@ void TestRefusedRollbackForcesSdr() {
-       {"tone-mapping", "mobius"},
+       {"tone-mapping", "bt.2390"},
@@ -327 +327 @@ void TestRefusedForcedSdrReportsUnknown() {
-       {"tone-mapping", "mobius"},
+       {"tone-mapping", "bt.2390"},
