+if set -q GHOSTTY_RESOURCES_DIR
+    printf 'TINYMUX_E2E_NESTED_HOST_INTEGRATION\\n'
+    function __tinymux_e2e_ghostty_prompt_start --on-event fish_prompt
+        printf '\\e]133;A\\a'
