 // Out-of-line state keeps the installed Aquamarine ABI unchanged.
 struct FrameDesktopState {
     SP<CCSteamFrameDesktopManagerV1> manager;
+    SP<CCWlOutput> parentOutput;
+    SP<CCWpPresentation> presentation;
+    uint32_t refresh = 0;
+    uint32_t clock = UINT32_MAX;
+    std::unordered_map<CWaylandOutput*, std::vector<SP<CCWpPresentationFeedback>>> feedbacks;
     uint32_t appId = 0, alpha = 0, width = 1280, height = 800;
     std::string title;
 };
 static std::unordered_map<CWaylandBackend*, FrameDesktopState> frameDesktops;
+
+static void updateFrameRefresh(CWaylandBackend* backend, uint32_t refresh, CBackend* core, const std::vector<SP<CWaylandOutput>>& outputs) {
+    auto& desktop = frameDesktops.at(backend);
+    if (!refresh || refresh == desktop.refresh)
+        return;
+    desktop.refresh = refresh;
+    core->log(AQ_LOG_DEBUG, std::format("Native desktop parent refresh: {} mHz", refresh));
+    for (auto& output : outputs) {
+        output->modes = {makeShared<SOutputMode>(SOutputMode{
+            .pixelSize = {static_cast<int>(desktop.width), static_cast<int>(desktop.height)}, .refreshRate = refresh, .preferred = true})};
+        // Reapply the preferred mode outside protocol event dispatch.
+        core->addIdleEvent(makeShared<std::function<void(void)>>([weak = output->self]() {
+            if (auto output = weak.lock())
+                output->events.state.emit(IOutput::SStateEvent{});
+        }));
+    }
+}
+
 
 
