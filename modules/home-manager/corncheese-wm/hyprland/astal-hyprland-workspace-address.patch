Subject: [PATCH] hyprland: support workspace addresses introduced in 0.56

Preserve Astal's integer workspace API for existing consumers while resolving
numbered, named and special addresses consistently in JSON and socket events.
Keep native addresses for Astal workspace dispatchers and retain legacy ID
parsing for older Hyprland versions.

diff --git a/src/client.vala b/src/client.vala
index ac98823..7da2d11 100644
--- a/src/client.vala
+++ b/src/client.vala
@@ -51,7 +51,7 @@ public class Client : Object {
         fullscreen = (Fullscreen)obj.get_int_member("fullscreen");
         fullscreen_client = (Fullscreen)obj.get_int_member("fullscreenClient");

-        workspace = hyprland.get_workspace((int)obj.get_object_member("workspace").get_int_member("id"));
+        workspace = hyprland.get_workspace(hyprland.workspace_id(obj.get_object_member("workspace")));
         monitor = hyprland.get_monitor((int)obj.get_int_member("monitor"));
     }

@@ -64,8 +64,7 @@ public class Client : Object {
     }

     public void move_to(Workspace ws) {
-        var id = ws.id;
-        Hyprland.get_default().dispatch("movetoworkspacesilent", @"$id,address:0x$address");
+        Hyprland.get_default().dispatch("movetoworkspacesilent", @"$(ws.selector),address:0x$address");
     }

     public void toggle_floating() {
diff --git a/src/hyprland.vala b/src/hyprland.vala
index 5f6d6b4..1aa5217 100644
--- a/src/hyprland.vala
+++ b/src/hyprland.vala
@@ -39,6 +39,36 @@ public class Hyprland : Object {
     private HashTable<int, Workspace> _workspaces =
         new HashTable<int, Workspace>((i) => i, ((a, b) => a == b));

+    // Hyprland 0.56 replaces numeric workspace IDs with string addresses.
+    // Keep the existing integer API, with stable IDs for named/special spaces.
+    private HashTable<string, int> _workspace_ids =
+        new HashTable<string, int>(str_hash, str_equal);
+    private int next_named_workspace_id = 13371337;
+    private int next_special_workspace_id = -99;
+
+    internal int workspace_id_from_address(string address) {
+        if (address == "") return 0; // no active special workspace
+
+        int id;
+        if (int.try_parse(address, out id)) return id;
+        if (_workspace_ids.contains(address)) return _workspace_ids.get(address);
+
+        if (address.has_prefix("special:")) {
+            do { id = next_special_workspace_id--; } while (_workspaces.contains(id));
+        } else {
+            do { id = next_named_workspace_id++; } while (_workspaces.contains(id));
+        }
+        _workspace_ids.insert(address, id);
+        return id;
+    }
+
+    internal int workspace_id(Json.Object obj) {
+        if (obj.has_member("id")) return (int)obj.get_int_member("id");
+        if (obj.has_member("address"))
+            return workspace_id_from_address(obj.get_string_member("address"));
+        return 0;
+    }
+
     private HashTable<string, Client> _clients =
         new HashTable<string, Client>(str_hash, str_equal);

@@ -226,7 +256,7 @@ public class Hyprland : Object {
             if (mon.get_object().get_member("focused").get_boolean()) focused_monitor = m;
         }
         foreach (var wrkpsc in wrkspcs.get_elements()) {
-            var id = (int)wrkpsc.get_object().get_member("id").get_int();
+            var id = workspace_id(wrkpsc.get_object());
             _workspaces.set(id, new Workspace());
         }
         foreach (var clnt in clnts.get_elements()) {
@@ -240,7 +270,7 @@ public class Hyprland : Object {
             get_client(addr).sync(c.get_object());
