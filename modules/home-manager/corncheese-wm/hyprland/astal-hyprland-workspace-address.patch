@@ -317,7 +347,7 @@ public class Hyprland : Object {
             case "workspacev2": {
                 yield sync_workspaces();
                 yield sync_monitors();
-                focused_workspace = get_workspace(int.parse(args[1]));
+                focused_workspace = get_workspace(workspace_id_from_address(args[1].split(",", 2)[0]));
                 break;
             }
             case "focusedmon": {
@@ -349,7 +379,7 @@ public class Hyprland : Object {
                 break;
             }
             case "createworkspacev2": {
-                var id = int.parse(args[1].split(",", 2)[0]);
+                var id = workspace_id_from_address(args[1].split(",", 2)[0]);
                 var ws = new Workspace();
                 _workspaces.insert(id, ws);
                 yield sync_workspaces();
@@ -358,7 +388,7 @@ public class Hyprland : Object {
                 break;
             }
             case "destroyworkspacev2": {
-                var id = int.parse(args[1].split(",", 2)[0]);
+                var id = workspace_id_from_address(args[1].split(",", 2)[0]);
                 _workspaces.get(id).removed();
                 _workspaces.remove(id);
                 workspace_removed(id);
@@ -368,7 +398,7 @@ public class Hyprland : Object {
             case "moveworkspacev2": {
                 yield sync_workspaces();
                 yield sync_monitors();
-                focused_workspace = get_workspace(int.parse(args[1]));
+                focused_workspace = get_workspace(workspace_id_from_address(args[1].split(",", 2)[0]));
                 notify_property("workspaces");
                 break;
             }
@@ -412,8 +442,9 @@ public class Hyprland : Object {
                 yield sync_clients();
                 yield sync_workspaces();
                 var argv = args[1].split(",");
-                client_moved(get_client(argv[0]), get_workspace(int.parse(argv[1])));
-                get_client(argv[0]).moved_to(get_workspace(int.parse(argv[1])));
+                var ws = get_workspace(workspace_id_from_address(argv[1]));
+                client_moved(get_client(argv[0]), ws);
+                get_client(argv[0]).moved_to(ws);
                 break;
             }
             case "submap": {
