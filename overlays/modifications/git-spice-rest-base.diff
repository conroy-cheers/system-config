diff --git a/internal/gateway/github/pull_request_base.go b/internal/gateway/github/pull_request_base.go
new file mode 100644
index 0000000..1127b2b
--- /dev/null
+++ b/internal/gateway/github/pull_request_base.go
@@ -0,0 +1,67 @@
+package github
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+// UpdatePullRequestBase changes a pull request's base branch through GitHub's
+// REST API. The equivalent GraphQL mutation intermittently returns HTTP 502.
+func (c *Gateway) UpdatePullRequestBase(
+	ctx context.Context,
+	owner, repo string,
+	number int,
+	base string,
+) error {
+	endpoint, err := url.JoinPath(c.apiURL, "repos", owner, repo, "pulls", strconv.Itoa(number))
+	if err != nil {
+		return fmt.Errorf("build REST API URL: %w", err)
+	}
+
+	var body bytes.Buffer
+	if err := json.NewEncoder(&body).Encode(struct {
+		Base string `json:"base"`
+	}{Base: base}); err != nil {
+		return fmt.Errorf("encode REST request: %w", err)
+	}
+
+	token, err := c.tokens.Token(ctx)
+	if err != nil {
+		return fmt.Errorf("get GitHub token: %w", err)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPatch, endpoint, &body)
+	if err != nil {
+		return fmt.Errorf("build REST request: %w", err)
+	}
+	req.Header.Set("Accept", "application/vnd.github+json")
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Content-Type", "application/json")
+
+	res, err := c.httpClient.Do(req)
+	if err != nil {
+		return fmt.Errorf("send REST request: %w", err)
+	}
+
+	diagnostic, err := io.ReadAll(io.LimitReader(res.Body, maxErrorBody))
+	err = errors.Join(err, res.Body.Close())
+	if err != nil {
+		return fmt.Errorf("read REST response: %w", err)
+	}
+	if res.StatusCode < http.StatusOK || res.StatusCode >= http.StatusMultipleChoices {
+		return fmt.Errorf(
+			"GitHub REST HTTP status %s: %s",
+			res.Status,
+			strings.TrimSpace(string(diagnostic)),
+		)
+	}
+	return nil
+}
