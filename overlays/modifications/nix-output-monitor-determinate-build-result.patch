Determinate Nix emits resBuildResult (110) with an object payload rather
than a fields array. Recognize this supplementary metadata without using
it to update progress: the existing activity events already track builds,
and AlreadyValid results must not be counted as newly completed builds.

diff --git a/lib/NOM/NixMessage/JSON.hs b/lib/NOM/NixMessage/JSON.hs
--- a/lib/NOM/NixMessage/JSON.hs
+++ b/lib/NOM/NixMessage/JSON.hs
@@ -71,6 +71,8 @@ data ActivityResult where
   SetExpected :: ActivityType -> Int -> ActivityResult
   PostBuildLogLine :: Text -> ActivityResult
   FetchStatus :: Text -> ActivityResult
+  -- Determinate Nix metadata; progress is tracked through activity events.
+  BuildResult :: ActivityResult
   deriving stock (Show, Eq)

 data ActivityProgress = MkActivityProgress
diff --git a/lib/NOM/Parser/JSON.hs b/lib/NOM/Parser/JSON.hs
--- a/lib/NOM/Parser/JSON.hs
+++ b/lib/NOM/Parser/JSON.hs
@@ -121,6 +121,9 @@ parseResultAction = do
       pure $ SetExpected activityType number
     107 -> PostBuildLogLine <$> one txt
     108 -> FetchStatus <$> one txt
+    -- resBuildResult has a payload object, not fields. It is supplementary
+    -- metadata and is handled by processJsonMessage's noChange fallback.
+    110 -> pure BuildResult
     other -> fail ("invalid activity result type: " <> show other)
   pure MkResultAction{id = idField, result}

